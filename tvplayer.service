[Unit]
Description=tvPlayer - Video Channel Player
After=multi-user.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
User=dp
WorkingDirectory=/home/dp/tvPlayer
ExecStart=/usr/bin/python3 -u tvPlayer.py
# Required for mpv to reach the user PipeWire socket. Without it the
# pipewire/pulse AOs fail to init and there is no audio at all.
# Check the real uid with `id -u dp`.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=on-failure
RestartSec=200ms
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
